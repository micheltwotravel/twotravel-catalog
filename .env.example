# Copy this file to .env for local development
# For staging/production, set these in Vercel dashboard (Settings → Environment Variables)

# Main GAS script (concierge panel, kickoffs, bodas, etc.)
VITE_GAS_URL=

# Feedback form GAS script
VITE_GAS_URL_FEEDBACK=

# Catalog / questionnaire GAS script
VITE_GAS_URL_CATALOG=

# Slack bot token (for sending PDFs and order notifications)
VITE_SLACK_BOT_TOKEN=

# Slack channel for ORDER notifications (drinks, groceries, breakfast)
VITE_SLACK_CHANNEL_ID=

# Slack channel specifically for drinks orders (falls back to VITE_SLACK_CHANNEL_ID)
VITE_SLACK_DRINKS_CHANNEL_ID=

# Slack channel for BILLING/INVOICE notifications — itinerary PDFs (#46)
# Set this to a separate channel to keep invoices separate from order pings
VITE_SLACK_BILLING_CHANNEL_ID=
