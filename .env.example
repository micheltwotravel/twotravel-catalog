# Copy this file to .env for local development
# For staging/production, set these in Vercel dashboard (Settings → Environment Variables)

# Main GAS script (concierge panel, kickoffs, bodas, etc.)
VITE_GAS_URL=

# Feedback form GAS script
VITE_GAS_URL_FEEDBACK=

# Catalog / questionnaire GAS script
VITE_GAS_URL_CATALOG=

# Slack bot token (for sending PDFs and order notifications)
VITE_SLACK_BOT_TOKEN=

# Slack channel for ORDER notifications (drinks, groceries, breakfast) — "Pedidos" group
VITE_SLACK_ORDERS_CHANNEL_ID=
# Fallback general channel (used if VITE_SLACK_ORDERS_CHANNEL_ID is not set)
VITE_SLACK_CHANNEL_ID=

# Slack channel for BILLING/INVOICE notifications — itinerary PDFs — "Itinerarios Factura" group
VITE_SLACK_BILLING_CHANNEL_ID=

# HubSpot lead attribution (hutk tracking)
# VITE_HUBSPOT_PORTAL_ID: your HubSpot account/portal ID (number in HubSpot URL, e.g. 12345678)
# HUBSPOT_PORTAL_ID: same value, server-side (Vercel env var, not VITE_ prefix)
# HUBSPOT_FORM_GUID: GUID of a HubSpot form created for this integration
#   → In HubSpot: Marketing → Forms → create "Two Travel Intake" form → embed code shows the GUID
VITE_HUBSPOT_PORTAL_ID=
HUBSPOT_PORTAL_ID=
HUBSPOT_FORM_GUID=
